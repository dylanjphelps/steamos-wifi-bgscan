#!/bin/sh

PATH="${PATH:-/usr/sbin:/usr/bin:/sbin:/bin}"
export PATH

interface="${1:-}"
event="${2:-}"
[ "$event" = "up" ] || exit 0
[ -n "$interface" ] || exit 0

device_type="$(nmcli -g GENERAL.TYPE device show "$interface" 2>/dev/null)" || exit 0
case "$device_type" in
    wifi|802-11-wireless) ;;
    *) exit 0 ;;
esac

if ! command -v wpa_cli >/dev/null 2>&1; then
    logger -t steamos-wifi-bgscan "wpa_cli is unavailable; cannot disable background scans on $interface"
    exit 0
fi

networks="$(wpa_cli -i "$interface" list_networks 2>/dev/null)" || {
    logger -t steamos-wifi-bgscan "wpa_supplicant is unavailable on $interface; no change made"
    exit 0
}
network_id="$(printf '%s\n' "$networks" | awk '$NF == "[CURRENT]" { print $1; exit }')"
case "$network_id" in
    ''|*[!0-9]*)
        logger -t steamos-wifi-bgscan "no active wpa_supplicant network on $interface"
        exit 0
        ;;
esac

result="$(wpa_cli -i "$interface" set_network "$network_id" bgscan '""' 2>/dev/null)" || {
    logger -t steamos-wifi-bgscan "could not disable background scans for network $network_id on $interface"
    exit 0
}
if [ "$result" != "OK" ]; then
    logger -t steamos-wifi-bgscan "wpa_supplicant rejected the bgscan setting for network $network_id on $interface"
    exit 0
fi

logger -t steamos-wifi-bgscan "disabled background scans for network $network_id on $interface"
